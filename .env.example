LEADER_CODE=codigo-de-lideres
MISSIONARY_CODE=codigo-de-misioneros
TIMEZONE=America/Argentina/Buenos_Aires
# Local: archivo SQLite. Producción: la URL de Turso (libsql://...) y su token.
DATABASE_URL=file:almuerzos.db
DATABASE_AUTH_TOKEN=
